# 复制为 config.env.test 或 config.env.prod 后填写
# 启动：APP_ENV=test go run .   或   APP_ENV=prod go run .

APP_ENV=test

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=your_database

PORT=8061

# jiuba 主站 API（overlay 会话回调，免签名 outsideapi）
JIUBA_API_BASE=https://house.makoo.xyz
